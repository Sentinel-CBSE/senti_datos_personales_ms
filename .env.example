# Este archivo lo usan DOS cosas distintas:
#  1. La app NestJS/TypeORM cuando corres local (npm run start:dev, migration:run).
#  2. docker-compose.yml, que lo carga automaticamente (por convencion, al estar
#     junto a el) para rellenar los ${DB_PASSWORD}, ${DB_USERNAME}, etc. que ves
#     ahi. Asi la contraseña/usuario/BD se definen una sola vez para los 3
#     contenedores (sqlserver, db-init, api) en vez de estar repetidos.
#
# DB_HOST NO participa en esa segunda parte: dentro de docker-compose el host
# siempre es el nombre del servicio ("sqlserver"), nunca "localhost". Ese valor
# de aqui solo aplica cuando corres la app fuera de Docker.

# Puerto en el que escucha el microservicio
PORT=3000

# Conexion a SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=ChangeMe_123!
DB_DATABASE=senti_datos_personales_db
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# true solo en desarrollo local (sincroniza el esquema automaticamente).
# En produccion siempre debe ser false y usar migraciones (npm run migration:run).
DB_SYNCHRONIZE=false
DB_LOGGING=false
